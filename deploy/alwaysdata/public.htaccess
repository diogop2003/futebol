Options -Indexes
DirectoryIndex index.html
RewriteEngine On

# Hidden files must not be served; allow certificate verification paths.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,END]

# Handle API routes before the Angular fallback. Preserve the original URL/query.
RewriteRule ^api(?:/|$) api/index.php [END,QSA]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

RewriteRule ^ index.html [END]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "DENY"
    <Files "index.html">
        Header set Cache-Control "no-cache"
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    </Files>
</IfModule>
